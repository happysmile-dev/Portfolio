# SMTP credentials used by the contact form (app/api/contact/route.ts).
# Copy this file to .env.local and fill in real values.
#
# For Gmail: enable 2-Step Verification on the account, then create an
# App Password (https://myaccount.google.com/apppasswords) and use it as SMTP_PASS.
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-app-password

# Optional overrides (defaults shown):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
